# Koobi faylkan u samee `.env` oo buuxi. Ha gelin GitHub / ha wadaagin.

# --- AI (bilaash: Google AI Studio) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
# Ikhtiyaari: LLM_MODEL=gemini-flash-latest
# Haddii aad isticmaalayso Groq/OpenRouter: LLM_PROVIDER=openai, LLM_BASE_URL=..., LLM_MODEL=...
LLM_DAILY_LIMIT=400

# --- Telegram (adiga, milkiilaha) ---
TELEGRAM_BOT_TOKEN=
# Bot fikradaha (adiga keliya) iyo bot-ka dadka/macaamiisha:
IDEAS_BOT_TOKEN=
PUBLIC_BOT_TOKEN=
# Ikhtiyaari: bot Telegram gaar ah xafiis kasta (Ikraan, Cabdiraxmaan, iwm. — src/personas.js).
# Samee bot kasta @BotFather, /setname = magaca xafiiska, /setuserpic = logo-ga FCS Technology.
# Qaabka: office:TOKEN,office:TOKEN,... (magacyada xafiisyada: maskax intake sales amni maaliyad siyaasad hawlgal taageero caawin suuq)
TELEGRAM_OFFICE_BOTS=
# Marka hore bot-ka u qor /start; wuxuu kuu sheegi doonaa chat id-gaaga. Halkan geli.
OWNER_CHAT_ID=

# --- Lacag-bixinta (sida macaamiilka loogu sheegayo) ---
# Tusaale: EVC Plus / Hormuud: 06xxxxxxx (Farah Abdishakur)
PAYMENT_DETAILS=

# --- Website (linkiyada adeegyada) ---
SITE_URL=https://fcs-tignoolaji.surge.sh

# --- Xisaabaadka macaamiisha: "Sign in with Google/Facebook" (email/password waa automatic, xisaab la'aan) ---
# Google: console.cloud.google.com -> OAuth Client ID (Web application), isla ID-gan VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Facebook: developers.facebook.com -> App cusub -> "Facebook Login" -> App ID/Secret. App ID-gu waa isla VITE_FACEBOOK_APP_ID.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Admin dashboard -> AI sync (bogga /admin marka "Cusboonaysii AI-ga" la riixo) ---
# Ha bannayn maran marka aad live tahay: samee erey qarsoon oo isla mid ah kan aad Admin.tsx ku qorto.
ADMIN_SYNC_TOKEN=

# --- Server ---
PORT=8787
ALLOWED_ORIGINS=http://localhost:8443,https://fcs-tignoolaji.surge.sh
REPORT_HOUR=8
TZ_OFFSET_HOURS=3
